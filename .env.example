# Copy this file to .env and fill in real values before deploying.

# development | production
APP_ENV=production

# Comma-separated list of origins allowed to call the API from a browser.
# Use "*" only for local development - lock this down in production.
ALLOWED_ORIGINS=https://your-domain.com

# Port the app listens on (most PaaS providers inject this automatically).
PORT=8000

# Optional: plug in a real news provider (NewsAPI, Benzinga, etc.) and wire
# it up in backend/market_data.py -> get_news(). Left blank = sample data.
NEWS_API_KEY=

LOG_LEVEL=INFO
